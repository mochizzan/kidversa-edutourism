FROM golang:1.26

# Install air for Go live-reload + wget for healthcheck
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/* && \
    go install github.com/air-verse/air@latest

WORKDIR /src

# Download dependencies first (Docker layer cache)
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

# Run migrations with a bounded retry (handles cold-start MariaDB), then start
# air (watches .go files, recompiles on change). The migration runner also has
# its own internal retry/self-heal for dirty schema state.
CMD ["sh", "-c", "for i in 1 2 3 4 5; do go run ./cmd/migrate && break; echo \"migrate attempt $i failed, retrying in 3s...\"; sleep 3; done && exec air"]
