FROM golang:1.26

# Install air for Go live-reload + wget for healthcheck
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/* && \
    go install github.com/air-verse/air@latest

WORKDIR /src

# Download dependencies first (Docker layer cache)
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

# Run migrations first with at most 3 attempts (cold-start MariaDB), then start
# air (watches .go files, recompiles on change) ONLY on success. If all attempts
# fail the backend MUST NOT boot — fail closed instead of starting on a broken
# schema.
CMD ["sh", "-c", "for i in 1 2 3; do go run ./cmd/migrate && exec air; echo \"migrate attempt $i failed\"; [ \"$i\" = 3 ] || { echo \"retrying in 3s...\"; sleep 3; }; done; echo \"migration failed after 3 attempts: backend will not start\"; exit 1"]
