# Database (MariaDB 12). Dev: container on host, root/admin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=kidversa
DB_MAX_OPEN=25
DB_MAX_IDLE=10
DB_CONN_MAX_LIFETIME=1h
# Root password untuk container MariaDB di docker compose (root).
# compose.yml membaca file ini via env_file pada service mariadb.
# Nilai disamakan dengan DB_PASSWORD (lokal = production, konsisten).
# TANPA baris ini, `docker compose up` gagal: MariaDB entrypoint
# "Database is uninitialized and password option is not specified".
MARIADB_ROOT_PASSWORD=admin
# DSN timeout params (hardcoded): timeout=5s, readTimeout=10s, writeTimeout=10s
# Prevents stale-connection hangs after idle (laptop sleep, Docker suspend).

# JWT (MUST be >= 32 random bytes; server refuses to start if shorter)
JWT_SECRET=change-me-to-a-long-random-32-byte-secret-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
REPORT_TOKEN_TTL_HOURS=168

# SSE session cookie
COOKIE_NAME=kidversa_session
# Dev (HTTP): Lax. Prod (HTTPS): None + COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# HTTP / server
SERVER_PORT=8080
# CORS_ORIGINS: daftar origin yang diizinkan, pisahkan koma.
# Contoh dev: http://localhost:5173  |  Contoh prod: https://app.kidversa.fun
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

# Rate limiting: per-IP per minute on the public report-access endpoints only —
# GET /api/reports/access, GET /api/reports/access/photo, GET /api/reports/gallery.
# POST /api/auth/login and POST /api/auth/refresh are NOT rate-limited.
RATE_LIMIT_PER_MIN=30
SSE_KEEPALIVE_SEC=15

# Bootstrap (superadmin password; WAJIB di-set, minimal 8 karakter)
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Force-reset superadmin password from env on migrate (recovery / forgotten password).
# Default false: a password already changed in the DB is NOT overwritten by routine
# migrations. Set to true only when you intend to reset it, then set back to false.
SUPERADMIN_FORCE_RESET=false

# WhatsApp (OpenWA self-hosted gateway) — used to deliver consent links to parents.
# Local dev (no Docker): http://localhost:2785
# Docker Compose: http://wa-engine:2785
WHATSAPP_GATEWAY_URL=http://localhost:2785
# Optional: API key from OpenWA .api-key file. Leave empty if not using API key auth.
WHATSAPP_API_KEY=
# Session NAME to search for in OpenWA (OpenWA auto-generates UUIDs as IDs).
# Backend searches by NAME, then caches the UUID. If session is deleted/recreated,
# backend auto-discovers the new UUID. Find session names via: GET /api/sessions
WHATSAPP_SESSION_ID=main
# Frontend consent page URL sent to parents via WhatsApp.
# Docker dev: http://localhost:8002/consent/respond
# Production: https://kidversa.fun/consent/respond
PARENT_CONSENT_BASE_URL=http://localhost:8002/consent/respond

# Frontend parent rapor page URL sent via WhatsApp (token appended as ?token=...).
# Send/Send All fail with report_link_not_configured when this is empty.
# Docker dev: http://localhost:8002/parent/report | Production: https://kidversa.fun/parent/report
PARENT_REPORT_BASE_URL=http://localhost:8002/parent/report

# OpenRouter AI (narrative generation)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1024
