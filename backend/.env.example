# Database (MariaDB 12). Dev: container on host, root/admin.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin
DB_NAME=kidversa
DB_MAX_OPEN=25
DB_MAX_IDLE=10
DB_CONN_MAX_LIFETIME=1h

# JWT (MUST be >= 32 random bytes; server refuses to start if shorter)
JWT_SECRET=change-me-to-a-long-random-32-byte-secret-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
REPORT_TOKEN_TTL_HOURS=168

# SSE session cookie
COOKIE_NAME=kidversa_session
# Dev (HTTP): Lax. Prod (HTTPS): None + COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# HTTP / server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

# Rate limiting (per-IP per minute on auth + report-access endpoints)
RATE_LIMIT_PER_MIN=60
SSE_KEEPALIVE_SEC=15

# Backends (single-instance v1)
REALTIME_BACKEND=memory
REVOKER_BACKEND=memory

# Bootstrap (superadmin password; empty => default 'password123' + must_change_password)
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Isolated test database (for `go test`, not prod/dev)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=admin
TEST_DB_NAME=kidversa_test
